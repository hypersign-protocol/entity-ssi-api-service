{
  "serviceType": "SSI_API",
  "version": "3.7.2",
  "globalPrefix": "api/v1",
  "versioning": "NONE",
  "uriVersionPrefix": "v",
  "defaultVersion": "1",
  "pricingNotes": [
    "API_CREDIT is committed automatically after a successful HTTP handler.",
    "Deterministic on-chain routes reserve their fixed uhid fee as BLOCKCHAIN_TXN_CREDIT with DEFERRED settlement and autoRecover disabled; the transaction processor must explicitly commit or roll it back from the chain result.",
    "POST /api/v1/credential/issue always catalogs its 5 API_CREDIT base cost. When persist=true, application code must reserve and immediately settle another 4 API_CREDIT. When registerCredentialStatus=true (the current default), application code must reserve 5 API_CREDIT plus 2000 deferred BLOCKCHAIN_TXN_CREDIT.",
    "PATCH /api/v1/did always catalogs its 3 API_CREDIT base cost. When didDocument is present, application code must reserve 5 API_CREDIT plus 1000 deferred BLOCKCHAIN_TXN_CREDIT for update or deactivate.",
    "The dashboard grant producer must grant separate API_CREDIT and BLOCKCHAIN_TXN_CREDIT wallets for SSI_API before this catalog is enforced."
  ],
  "routes": [
    { "method": "GET", "path": "/api/v1/credential", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 1 }] },
    { "method": "GET", "path": "/api/v1/credential/:credentialId", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 1 }] },
    { "method": "POST", "path": "/api/v1/credential/issue", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 5 }] },
    { "method": "PATCH", "path": "/api/v1/credential/status/:credentialId", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 8 }, { "id": "blockchain-transaction", "creditType": "BLOCKCHAIN_TXN_CREDIT", "amount": 2000, "settlementMode": "DEFERRED", "autoRecover": false }] },
    { "method": "POST", "path": "/api/v1/credential/status/register", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 10 }, { "id": "blockchain-transaction", "creditType": "BLOCKCHAIN_TXN_CREDIT", "amount": 2000, "settlementMode": "DEFERRED", "autoRecover": false }] },
    { "method": "POST", "path": "/api/v1/credential/verify", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 5 }] },

    { "method": "GET", "path": "/api/v1/credit", "charges": [] },
    { "method": "POST", "path": "/api/v1/credit", "charges": [] },
    { "method": "GET", "path": "/api/v1/credit/:creditId", "charges": [] },
    { "method": "POST", "path": "/api/v1/credit/:creditId/activate", "charges": [] },

    { "method": "GET", "path": "/api/v1/did", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 1 }] },
    { "method": "PATCH", "path": "/api/v1/did", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 3 }] },
    { "method": "POST", "path": "/api/v1/did/addVerificationMethod", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 5 }] },
    { "method": "POST", "path": "/api/v1/did/auth/issue-jwt", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 5 }] },
    { "method": "POST", "path": "/api/v1/did/auth/sign", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 5 }] },
    { "method": "POST", "path": "/api/v1/did/auth/verify", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 5 }] },
    { "method": "POST", "path": "/api/v1/did/create", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 7 }] },
    { "method": "POST", "path": "/api/v1/did/register", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 10 }, { "id": "blockchain-transaction", "creditType": "BLOCKCHAIN_TXN_CREDIT", "amount": 4000, "settlementMode": "DEFERRED", "autoRecover": false }] },
    { "method": "POST", "path": "/api/v1/did/register/v2", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 10 }, { "id": "blockchain-transaction", "creditType": "BLOCKCHAIN_TXN_CREDIT", "amount": 4000, "settlementMode": "DEFERRED", "autoRecover": false }] },
    { "method": "GET", "path": "/api/v1/did/resolve/:did", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 1 }] },

    { "method": "POST", "path": "/api/v1/presentation", "charges": [] },
    { "method": "POST", "path": "/api/v1/presentation/request", "charges": [] },
    { "method": "GET", "path": "/api/v1/presentation/template", "charges": [] },
    { "method": "POST", "path": "/api/v1/presentation/template", "charges": [] },
    { "method": "DELETE", "path": "/api/v1/presentation/template/:templateId", "charges": [] },
    { "method": "GET", "path": "/api/v1/presentation/template/:templateId", "charges": [] },
    { "method": "PATCH", "path": "/api/v1/presentation/template/:templateId", "charges": [] },
    { "method": "POST", "path": "/api/v1/presentation/verify", "charges": [] },

    { "method": "GET", "path": "/api/v1/schema", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 1 }] },
    { "method": "POST", "path": "/api/v1/schema", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 10 }, { "id": "blockchain-transaction", "creditType": "BLOCKCHAIN_TXN_CREDIT", "amount": 2000, "settlementMode": "DEFERRED", "autoRecover": false }] },
    { "method": "GET", "path": "/api/v1/schema/:schemaId", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 1 }] },
    { "method": "POST", "path": "/api/v1/schema/register", "charges": [{ "id": "api", "creditType": "API_CREDIT", "amount": 10 }, { "id": "blockchain-transaction", "creditType": "BLOCKCHAIN_TXN_CREDIT", "amount": 2000, "settlementMode": "DEFERRED", "autoRecover": false }] },

    { "method": "GET", "path": "/api/v1/status/ssi/:id", "charges": [] },
    { "method": "GET", "path": "/api/v1/status/transaction/:transactionHash", "charges": [] },
    { "method": "GET", "path": "/api/v1/usage", "charges": [] },
    { "method": "GET", "path": "/api/v1/usage/detail", "charges": [] }
  ]
}
